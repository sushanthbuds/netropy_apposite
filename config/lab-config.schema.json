{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netropy-lab.local/schemas/lab-config.json",
  "title": "Netropy Lab Configuration",
  "description": "JSON input for the Netropy VE automated provisioning CLI",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "ubuntu_lts_version",
    "ssh_public_key_file",
    "subnets",
    "instances"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": ["kvm", "esxi"],
      "description": "Target platform for provisioning"
    },
    "netropy_image": {
      "type": "string",
      "minLength": 1,
      "description": "KVM: path to Netropy VE qcow2. Required when provision_netropy is true."
    },
    "ubuntu_lts_version": {
      "type": "string",
      "pattern": "^\\d{2}\\.\\d{2}$",
      "description": "Ubuntu LTS version, e.g. 24.04"
    },
    "naming_prefix": {
      "type": "string",
      "minLength": 1,
      "description": "Prefix for VM and resource names (default: netropy-lab)"
    },
    "ssh_public_key_file": {
      "type": "string",
      "minLength": 1,
      "description": "Path to SSH public key file on the provisioning host"
    },
    "subnets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mgmt", "data1", "data2"],
      "properties": {
        "mgmt": { "$ref": "#/$defs/subnet" },
        "data1": { "$ref": "#/$defs/subnet" },
        "data2": { "$ref": "#/$defs/subnet" }
      }
    },
    "instances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["netropy", "linux1", "linux2"],
      "properties": {
        "netropy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mgmt_ip", "data1_ip", "data2_ip"],
          "properties": {
            "mgmt_ip": { "$ref": "#/$defs/ipv4" },
            "data1_ip": { "$ref": "#/$defs/ipv4" },
            "data2_ip": { "$ref": "#/$defs/ipv4" }
          }
        },
        "linux1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mgmt_ip", "data_ip"],
          "properties": {
            "mgmt_ip": { "$ref": "#/$defs/ipv4" },
            "data_ip": { "$ref": "#/$defs/ipv4" }
          }
        },
        "linux2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mgmt_ip", "data_ip"],
          "properties": {
            "mgmt_ip": { "$ref": "#/$defs/ipv4" },
            "data_ip": { "$ref": "#/$defs/ipv4" }
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provision_netropy": {
          "type": "boolean",
          "description": "When false, skip Netropy VM until image is available"
        },
        "passthrough_data_ports": {
          "type": "boolean",
          "description": "Use passthrough data ports (stretch goal)"
        },
        "vcpu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "vCPUs per VM"
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 512,
          "maximum": 131072,
          "description": "Memory per VM in MiB"
        }
      }
    },
    "credentials": {
      "type": "object",
      "description": "Platform credential hints only; use env vars for real secrets",
      "additionalProperties": true
    }
  },
  "$defs": {
    "subnet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidr"],
      "properties": {
        "cidr": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$",
          "description": "IPv4 CIDR notation"
        }
      }
    },
    "ipv4": {
      "type": "string",
      "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}$",
      "description": "IPv4 address"
    }
  }
}
